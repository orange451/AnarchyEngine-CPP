+
+/// A solid cylinder: two flat caps joined by a round side.
+typedef struct b3Cylinder
+{
+	/// Local center of the first cap
+	b3Vec3 center1;
+
+	/// Local center of the second cap
+	b3Vec3 center2;
+
+	/// The radius of the caps
+	float radius;
+} b3Cylinder;
+
+/**@}*/ // cylinder
